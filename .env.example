# Variables d'environnement de l'atelier. Copiez en `.env` (non versionné) et
# renseignez de vraies valeurs. Aucune vraie valeur ne doit vivre dans ce fichier.

# La clé du fournisseur de raisonnement. Vit dans l'environnement du service,
# jamais côté client. Sans elle, la page rejoue une démonstration enregistrée.
OPENROUTER_API_KEY=

# Le modèle par défaut du relais de raisonnement.
USINE_MODEL=deepseek/deepseek-v4-flash

# L'origine publique du site. Le lien de connexion (redemption) est bâti dessus.
USINE_ORIGIN=https://usine.memolabs.dev

# PostgreSQL. Sans elle, le service retombe sur un stockage en mémoire
# (runs perdus au redémarrage). Format : postgresql://user:pass@host:5432/usine
DATABASE_URL=

# Envoi du lien de connexion. Sans SMTP_HOST, le lien est seulement journalisé
# (dev), jamais envoyé.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=atelier@memolabs.dev
SMTP_TLS=1

# Fenêtre de rétention de la corbeille (jours) avant purge, si vous la câblez.
RUN_TRASH_RETENTION_DAYS=30

# Port du relais en conteneur. Surtout pas PORT : une PaaS y met le port public
# du conteneur (Coolify y mettait 80) et le relais entrait en collision avec nginx.
RELAY_PORT=3000
