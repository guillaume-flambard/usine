# Variables d'environnement de l'atelier. Copiez en `.env` (non versionné) et
# renseignez de vraies valeurs. Aucune vraie valeur ne doit vivre dans ce fichier.

# L'origine publique du site. Le lien de connexion (redemption) est bâti dessus.
USINE_ORIGIN=https://usine.memolabs.dev

# PostgreSQL. Sans base, le service retombe sur un stockage en mémoire, et les
# runs sont perdus au redémarrage.
#
# Passer les morceaux : le service assemble la chaîne à un seul endroit
# (usine_api/settings.py). Le compose de dev pose déjà POSTGRES_HOST=db ; seul le
# mot de passe est à renseigner, et il est requis.
POSTGRES_PASSWORD=
POSTGRES_USER=usine
POSTGRES_DB=usine
# Port publié sur 127.0.0.1 par le compose de dev (5432 par défaut).
POSTGRES_PUBLISHED_PORT=5432
# DATABASE_URL, si elle est posée, garde la priorité. C'est utile pour la purge
# de rétention lancée à la main.
DATABASE_URL=

# Observabilité : le Langfuse du lab (MEM-16), SDK Python v5, serveur 4.59 ou
# plus. Sans clés, le service ne trace pas ; avec des clés et Langfuse
# injoignable, le run continue et le service le dit une fois dans ses logs.
# LANGFUSE_HOST reste lu par le SDK, mais il est déprécié.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Modèles : la passerelle LiteLLM du lab (MEM-13). Jamais une clé de fournisseur
# ici : seulement la clé LiteLLM propre à l'usine. Sans LITELLM_BASE_URL, aucun
# appel de modèle. En local, par un tunnel : ssh -L 4000:127.0.0.1:4000 lab
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Un model_name de LiteLLM (lab-fast par défaut). Le repli est dans LiteLLM.
USINE_MODEL=
# Paramètres hors norme du corps, en JSON. Par défaut {"enable_thinking": false}
# (raisonnement coupé) ; {} pour un modèle qui ne connaît pas ce paramètre.
# USINE_MODEL_EXTRAS=

# Envoi du lien de connexion. Sans SMTP_HOST, le lien est seulement journalisé
# (dev), jamais envoyé.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=atelier@memolabs.dev
SMTP_TLS=1

# Fenêtre de rétention de la corbeille (jours) avant purge, si vous la câblez.
RUN_TRASH_RETENTION_DAYS=30

# Ou les harnais `eval-portes.py` deposent leurs verdicts, un fichier
# `<agent>.json` par agent. Vide = l'ecran des portes est eteint et le dit.
PORTES_DIR=

# Le depot des agents, pour rejouer un harnais a la demande. Le harnais tourne
# la ou il est clone : sur cette machine, pas sur le VPS, qui n'a ni clone de
# lab-infra ni droit de poussee dessus (voir stacks/guichet/guichet.py).
LAB_INFRA_DIR=

# Ce que l'observateur du lab depose dans le vault, lu tel quel. Vide = l'ecran
# de la flotte est eteint et le dit.
FLOTTE_JSON=
