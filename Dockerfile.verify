# Verification image for the VPS builder (MEM-6, decided 2026-11-14: CI runs
# in the trusted builder, not on GitHub-hosted machines).
#
# Building this image IS the check: the last RUN executes scripts/verify.sh and
# a failing check fails the build. Nothing is pushed and no secret is needed:
# the builder never passes its GitHub token to `docker build`.
#
# Base: the official Node image, then Chromium installed by the project's own
# Playwright version. https://playwright.dev/docs/docker warns that a browser
# image must match the npm version exactly, and the version used here is
# whatever pnpm-lock.yaml resolved.
FROM node:26-trixie

COPY --from=ghcr.io/astral-sh/uv:0.13.8 /uv /uvx /usr/local/bin/

ENV CI=1 \
    UV_LOCKED=1 \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    VITE_CONFIG_NATIVE_IGNORE_WARNING=true \
    USINE_VERIFY_PG=1

# A throwaway Postgres for the integration tests (checkpointer, stores). It is
# started by scripts/verify.sh inside this build and dies with it. The tests need
# plain Postgres, not pgvector. Postgres 18, the latest stable, comes from the
# PostgreSQL project's own APT repository (PGDG): Debian trixie ships 17.
# https://www.postgresql.org/download/linux/debian/
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates postgresql-common \
 && /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y \
 && apt-get install -y --no-install-recommends postgresql-18 \
 && rm -rf /var/lib/apt/lists/*

# Node 25 and later no longer ship corepack: it comes from npm, then reads the
# pnpm version pinned in package.json (packageManager).
RUN npm install -g corepack@0.36.0 && corepack enable
WORKDIR /src

# Dependencies first, so a source-only change reuses these layers.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @usine/web exec playwright install --with-deps chromium

COPY pyproject.toml uv.lock .python-version ./
COPY services/api/pyproject.toml services/api/
RUN uv sync --no-install-workspace

COPY . .
RUN ./scripts/verify.sh
