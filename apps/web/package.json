{
  "name": "@usine/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "e2e": "playwright test",
    "e2e:real": "E2E_REAL=1 playwright test"
  },
  "dependencies": {
    "@ai-sdk/vue": "4.0.173",
    "@comark/vue": "^0.9.2",
    "@dagrejs/dagre": "3.1.3",
    "@nuxt/ui": "^4.12.0",
    "ai": "7.0.173",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.155",
    "@playwright/test": "1.65.1",
    "@tsconfig/node26": "^26.0.2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.93.0",
    "eslint-plugin-vue": "~10.12.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.93.0",
    "playwright": "^1.65.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-browser-vue": "^3.1.0",
    "vue-tsc": "^3.3.14"
  }
}
