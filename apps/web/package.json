{
  "name": "@usine/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser"
  },
  "dependencies": {
    "@ai-sdk/vue": "4.0.165",
    "@dagrejs/dagre": "3.1.3",
    "@nuxt/ui": "^4.11.0",
    "ai": "7.0.165",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.74.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.11",
    "vitest-browser-vue": "^2.1.0",
    "vue-tsc": "^3.3.7"
