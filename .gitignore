# Vite
*.timestamp-*-*.mjs

# Generees par le plugin Vite de Nuxt UI a chaque dev/build. Elles portent le
# chemin pnpm avec son hash de contenu, donc elles changent a chaque lockfile et
# ne veulent rien dire d'une machine a l'autre.
auto-imports.d.ts
components.d.ts

# Secrets: never committed. The relay key lives here for local runs only.
.env
.env.*
# …sauf l'exemple, qui documente les variables (aucune vraie valeur).
!.env.example

# Le service Python garde son environnement hors du dépôt.
services/api/.venv/
services/api/**/__pycache__/
services/api/.pytest_cache/
services/api/.ruff_cache/
.claude/launch.json
