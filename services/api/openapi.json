              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Checkpoints",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/runs/{thread_id}/fork": {
      "post": {
        "description": "Ouvre une branche depuis un checkpoint et la fait diverger, en flux.\n\nLa branche a son propre identifiant (annoncé dans le premier événement)\net garde son lien à l'origine ; le run d'origine n'est pas modifié. Le\nflux est celui d'une reprise : seuls les nœuds après le point de fork\ns'exécutent, et le modèle est rappelé pour eux.",
        "operationId": "fork_thread_api_runs__thread_id__fork_post",
        "parameters": [
          {
            "in": "path",
            "name": "thread_id",
            "required": true,
            "schema": {
              "title": "Thread Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Fork Thread",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/runs/{thread_id}/gate": {
      "post": {
        "description": "Répond à la porte humaine : approuver, rejeter avec un motif, ou modifier puis approuver.\n\nPassé le délai (24 h), toute décision compte comme un rejet : une action\nirréversible ne part jamais sur une approbation périmée.",
        "operationId": "decide_gate_api_runs__thread_id__gate_post",
        "parameters": [
          {
            "in": "path",
            "name": "thread_id",
            "required": true,
            "schema": {
              "title": "Thread Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GateDecision"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Decide Gate",
        "tags": [
          "runs"
        ]
      }
    },
