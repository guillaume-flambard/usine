        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Open Thread",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/runs/{thread_id}/checkpoints": {
      "get": {
        "description": "Les points où le run peut être rejoué, du plus récent au plus ancien (MEM-23).",
        "operationId": "list_checkpoints_api_runs__thread_id__checkpoints_get",
        "parameters": [
          {
            "in": "path",
