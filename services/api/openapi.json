{
  "components": {
    "schemas": {
      "ChatMessage": {
        "description": "A `UIMessage`, reduced to what the service reads.",
        "properties": {
          "id": {
            "default": "",
            "title": "Id",
            "type": "string"
          },
          "parts": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Parts",
            "type": "array"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "title": "ChatMessage",
        "type": "object"
      },
      "ChatRequest": {
        "description": "The body `DefaultChatTransport` sends (ai@7.0.165, `HttpChatTransport.sendMessages`).",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "messageId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Messageid"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          },
          "trigger": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trigger"
          }
        },
        "required": [
          "messages"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "CheckpointSummary": {
        "description": "Ce qu'un client a besoin de savoir pour choisir un point de fork.",
        "properties": {
          "checkpoint_id": {
            "title": "Checkpoint Id",
            "type": "string"
          },
          "next": {
            "items": {
              "type": "string"
            },
            "title": "Next",
            "type": "array"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "step": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step"
          }
        },
        "required": [
          "checkpoint_id",
          "next"
        ],
        "title": "CheckpointSummary",
        "type": "object"
      },
      "ForkRequest": {
        "properties": {
          "brief": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brief"
          },
          "checkpoint_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkpoint Id"
          }
        },
        "title": "ForkRequest",
        "type": "object"
      },
      "GateDecision": {
        "additionalProperties": false,
        "description": "Approve, reject with a reason, or edit the actions then approve them.",
        "properties": {
          "actions": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ProposedAction"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actions"
          },
          "decision": {
            "enum": [
              "approve",
              "reject",
              "edit"
            ],
            "title": "Decision",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "decision"
        ],
        "title": "GateDecision",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ProposedAction": {
        "additionalProperties": false,
        "properties": {
          "justification": {
            "minLength": 1,
            "title": "Justification",
            "type": "string"
          },
          "kind": {
            "enum": [
              "external_write",
              "send",
              "pull_request"
            ],
            "title": "Kind",
            "type": "string"
          },
          "preview": {
            "description": "What would leave the runtime: a diff, a message.",
            "title": "Preview",
            "type": "string"
          },
          "target": {
            "description": "Named target, never an address.",
            "minLength": 1,
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "target",
          "justification",
          "preview"
        ],
        "title": "ProposedAction",
        "type": "object"
      },
      "RunDetail": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "gate": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gate"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/RunTurn"
            },
            "title": "History",
            "type": "array"
          },
          "parent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunParent"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "running",
              "waiting",
              "deciding",
              "done",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "turns": {
            "title": "Turns",
            "type": "integer"
          }
        },
        "required": [
          "thread_id",
          "title",
          "status",
          "created_at",
          "turns",
          "history"
        ],
        "title": "RunDetail",
        "type": "object"
      },
      "RunPage": {
        "description": "Une page de runs, et le curseur de la suivante (absent à la fin).",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RunSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "RunPage",
        "type": "object"
      },
      "RunParent": {
        "description": "Where a branch comes from (MEM-23).",
        "properties": {
          "checkpoint_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkpoint Id"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id"
        ],
        "title": "RunParent",
        "type": "object"
      },
      "RunSummary": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "parent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunParent"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "running",
              "waiting",
              "deciding",
              "done",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "turns": {
            "title": "Turns",
            "type": "integer"
          }
        },
        "required": [
          "thread_id",
          "title",
          "status",
          "created_at",
          "turns"
        ],
        "title": "RunSummary",
        "type": "object"
      },
      "RunTurn": {
        "properties": {
          "answer": {
            "default": "",
            "title": "Answer",
            "type": "string"
          },
          "brief": {
            "title": "Brief",
            "type": "string"
          },
          "events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "brief"
        ],
        "title": "RunTurn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
