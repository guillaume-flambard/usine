{
  "name": "usine",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @usine/web run dev",
    "build": "pnpm --filter @usine/web run build",
    "type-check": "pnpm --filter @usine/web run type-check",
    "lint": "pnpm --filter @usine/web run lint && pnpm lint:api",
    "lint:api": "uv run ruff check services/api && uv run ruff format --check services/api",
    "format": "prettier --write --experimental-cli apps/web/src",
    "format:api": "uv run ruff check --fix services/api && uv run ruff format services/api",
    "test": "pnpm --filter @usine/web run test",
    "test:browser": "pnpm --filter @usine/web run test:browser",
    "test:api": "uv run pytest",
    "test:all": "pnpm test && pnpm test:browser && pnpm test:api"
  },
  "devDependencies": {
    "prettier": "3.9.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@11.22.0"
}
