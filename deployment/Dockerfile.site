# Le site seul : le paquet statique et le cadre isolé, servis par nginx.
#
# Il ne porte plus le relais — celui-ci est devenu un service à part
# (`services/api`), ce qui rend enfin possible ce que le conteneur unique
# interdisait : joindre l'API par un nom stable au lieu de la boucle locale.
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

FROM nginx:alpine AS service
COPY --from=build /app/dist /usr/share/nginx/html
COPY deployment/nginx.compose.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

# La sonde interroge ce que le visiteur reçoit. Traefik ne route pas vers un
# conteneur marqué malsain : une sonde qui vérifie autre chose que la page
# servie produit un 404 inexplicable.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget -q --spider http://127.0.0.1/ || exit 1
