{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  // `src/client/**` is vendored from `@cordisjs/client` and is checked by
  // `tsconfig.client.json` with its author's settings. Excluding it here is
  // what keeps this project strict for the code we actually write.
  "exclude": ["src/**/__tests__/*", "src/client/**"],
  "compilerOptions": {
    // Le moteur porté (src/usine/run.ts) indexe tableaux et maps partout (DOM impératif
    // d'origine). On garde `strict` mais on coupe ce flag opt-in (hors `strict`, "may have
    // false positives" d'après le scaffold) pour ne pas noyer le code sous les gardes d'index.
    "noUncheckedIndexedAccess": false,

    // Path mapping for cleaner imports.
    //
    // The last two mirror the Vite aliases for the vendored console shell.
    // They are not a convenience: `<script setup>` resolves the types behind
    // `defineProps<T>()` through tsconfig paths, never through Vite's
    // resolver, so without them every macro that names an upstream type fails
    // to compile with "Failed to resolve import source".
    "paths": {
      "@/*": ["./src/*"],
      "@cordisjs/client": ["./src/client/index.ts"],
      "@cordisjs/components": ["./src/client/vendor-components/index.ts"]
    },

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
